<Defs>
  <!-- Everyday interactions of the community modules: teaching, care, patrols, escorts, payday, research. They are played through the game's own interaction system, so they appear in the social log and as speech bubbles (Interaction Bubbles), and other social mods can see them. They change no opinions and cause no fights. -->
  <InteractionDef>
    <defName>WFL_Lesson</defName>
    <label>lesson</label>
    <symbol>Things/Mote/SpeechSymbols/DeepTalk</symbol>
    <initiatorXpGainSkill>Social</initiatorXpGainSkill>
    <initiatorXpGainAmount>3</initiatorXpGainAmount>
    <logRulesInitiator>
      <rulesStrings>
        <li>r_logentry->[INITIATOR_nameDef] taught [RECIPIENT_nameDef] a lesson.</li>
        <li>r_logentry->[INITIATOR_nameDef] went over the day&apos;s lesson with [RECIPIENT_nameDef].</li>
        <li>r_logentry->[INITIATOR_nameDef] explained something new to [RECIPIENT_nameDef].</li>
      </rulesStrings>
    </logRulesInitiator>
  </InteractionDef>
