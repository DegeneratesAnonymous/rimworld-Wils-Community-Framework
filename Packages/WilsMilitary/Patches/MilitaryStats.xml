<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Most vanilla StatDefs declare no parts list: append when one exists, otherwise create the list with the part in it. Always succeeds, so a stat another game version or
       mod does not have is skipped quietly instead of raising a patch error. -->
  <Operation Class="PatchOperationConditional">
    <success>Always</success>
    <xpath>Defs/StatDef[defName="MoveSpeed"]/parts</xpath>
    <match Class="PatchOperationAdd"><xpath>Defs/StatDef[defName="MoveSpeed"]/parts</xpath><value><li Class="FamilyLife.StatPart_MilitaryDoctrine" /></value></match>
    <nomatch Class="PatchOperationAdd"><success>Always</success><xpath>Defs/StatDef[defName="MoveSpeed"]</xpath><value><parts><li Class="FamilyLife.StatPart_MilitaryDoctrine" /></parts></value></nomatch>
  </Operation>
