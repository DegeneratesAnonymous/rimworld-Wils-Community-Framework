<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- A tax collection visit: the framework's shared talk job, with the meaning supplied by Wil's Role Modules : Treasury. -->
  <JobDef>
    <defName>WFL_TaxVisit</defName>
    <driverClass>FamilyLife.JobDriver_StoryTalk</driverClass>
    <reportString>collecting what TargetA owes.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>
  <ThoughtDef>
    <defName>WFL_TaxPaidFairly</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>fair collection</label><baseOpinionOffset>4</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>WFL_TaxPressured</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>pressed for money</label><baseOpinionOffset>-8</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>WFL_TaxRefusedAgainst</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>would not pay what is owed</label><baseOpinionOffset>-4</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <!-- Prolonged nonpayment, expressed as opinion of whoever keeps the books and as strain on the worker's household. The wages themselves stay owed in full. -->
  <ThoughtDef>
    <defName>WFL_WagesOwed</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>wages still unpaid</label><baseOpinionOffset>-5</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>WFL_WagesOwedLong</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>12</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>owed wages for a long time</label><baseOpinionOffset>-12</baseOpinionOffset></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>WFL_HouseholdStrain</defName>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>family short of money</label><description>Someone in my family has not been paid what they are owed.</description><baseMoodEffect>-3</baseMoodEffect></li></stages>
  </ThoughtDef>
  <!-- A colonist who holds almost nothing of their own while the colony is wealthy. Staged by how large the gap is; refreshed by the treasury's periodic pass and gone when the gap closes. -->
  <ThoughtDef>
    <defName>WFL_WealthGap</defName>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li><label>a little left out of the colony's wealth</label><description>The colony has plenty and I have very little of my own.</description><baseMoodEffect>-2</baseMoodEffect></li>
      <li><label>left out of the colony's wealth</label><description>The colony is wealthy and I have almost nothing of my own to show for my work.</description><baseMoodEffect>-4</baseMoodEffect></li>
      <li><label>shut out of the colony's wealth</label><description>The colony is rich and I have next to nothing. It is hard not to resent it.</description><baseMoodEffect>-6</baseMoodEffect></li>
    </stages>
  </ThoughtDef>
  <!-- An investor whose stake pays a dividend feels good about it; the person who runs the business feels backed. Both are small and short. -->
  <ThoughtDef>
    <defName>WFL_InvestmentPaid</defName>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>my investment is paying off</label><description>Silver I put into a business is coming back with more.</description><baseMoodEffect>2</baseMoodEffect></li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>WFL_InvestorBacked</defName>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li><label>someone believes in my business</label><description>An investor put their own silver behind what I run. I do not want to let them down.</description><baseMoodEffect>3</baseMoodEffect></li></stages>
  </ThoughtDef>
  <!-- The Treasurer sits at the Treasury chair to deal with waiting financial business. Nothing is decided here; the books were settled when the operation happened. -->
  <JobDef>
    <defName>WFL_TreasuryOffice</defName>
    <driverClass>FamilyLife.JobDriver_TreasuryOffice</driverClass>
    <reportString>seeing to the treasury accounts.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>
</Defs>
