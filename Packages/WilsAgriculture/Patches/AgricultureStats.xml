<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Most vanilla StatDefs do not declare a parts list. Append when one exists;
       otherwise create the list and its first Agriculture part together. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/StatDef[defName="PlantHarvestYield"]/parts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/StatDef[defName="PlantHarvestYield"]/parts</xpath>
      <value>
        <li Class="FamilyLife.StatPart_AgricultureSpecialty"><specialty>Horticulturist</specialty><factor>1.15</factor><label>Horticulturist</label></li>
        <li Class="FamilyLife.StatPart_AgricultureSpecialty"><specialty>Herbalist</specialty><factor>1.20</factor><label>Herbalist</label><target>medicine</target></li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/StatDef[defName="PlantHarvestYield"]</xpath>
      <value><parts>
        <li Class="FamilyLife.StatPart_AgricultureSpecialty"><specialty>Horticulturist</specialty><factor>1.15</factor><label>Horticulturist</label></li>
        <li Class="FamilyLife.StatPart_AgricultureSpecialty"><specialty>Herbalist</specialty><factor>1.20</factor><label>Herbalist</label><target>medicine</target></li>
      </parts></value>
    </nomatch>
  </Operation>

